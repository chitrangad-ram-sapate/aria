# Copy to .env.local (not committed) to choose the delivery map. See docs/geoproof.md.
# osm (default, no key) | google | none
VITE_MAP_PROVIDER=osm
# Needed only for google: a Maps JavaScript API key restricted to your app (billing must be enabled on the Google Cloud project)
VITE_GOOGLE_MAPS_KEY=

# Map tiles for the OpenStreetMap map (default: the public OSM servers; use your own for heavy use)
VITE_MAP_TILES_URL=
VITE_MAP_TILES_ATTRIBUTION=

# Your own Firebase project (all six; leave empty to use the ARIA project). Deploy firestore.rules to it too.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase emulators for local tests (?emulators=1)
VITE_EMULATOR_HOST=
VITE_EMULATOR_AUTH_PORT=
VITE_EMULATOR_FIRESTORE_PORT=

# Ask ARIA's language model (Groq). Without a key the chat still works offline with its own word rules.
# The key is built into the app, so use a key with a spending limit and never commit .env.local.
VITE_GROQ_API_KEY=
VITE_GROQ_MODEL=
