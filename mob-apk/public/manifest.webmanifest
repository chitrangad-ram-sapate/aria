{
  "name": "ARIA Planner",
  "short_name": "ARIA",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#0f5c4d",
  "theme_color": "#0f5c4d",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "application/vnd.aria.svcr+json": [
          ".svcr"
        ]
      }
    }
  ]
}
