{
  "name": "aria-mobile",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "sync-engine": "node scripts/sync-engine.mjs",
    "prepare-assets": "node scripts/prepare.mjs",
    "dev": "npm run prepare-assets && vite",
    "build": "npm run prepare-assets && tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "smoke": "node scripts/smoke.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "android": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug",
    "ios": "npm run build && npx cap sync ios",
    "emulators": "npx -y firebase-tools@13 emulators:start --only auth,firestore --project demo-aria",
    "rules-test": "node scripts/rules-test.mjs",
    "geofence-test": "node --no-warnings scripts/geofence-test.mjs",
    "assistant-test": "node --no-warnings scripts/assistant-test.mjs",
    "ai-test": "node --no-warnings scripts/ai-test.mjs",
    "deploy:rules": "npx -y firebase-tools@13 deploy --only firestore --project aria-triwiz"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "6.2.0",
    "@capacitor/android": "6.2.2",
    "@capacitor/app": "6.0.3",
    "@capacitor/core": "6.2.2",
    "@capacitor/filesystem": "6.0.4",
    "@capacitor/geolocation": "6.1.1",
    "@capacitor/ios": "6.2.2",
    "@capacitor/share": "6.0.4",
    "firebase": "11.10.0",
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.2",
    "@types/leaflet": "1.9.12",
    "fflate": "0.8.3",
    "playwright-core": "1.64.1",
    "pyodide": "0.27.8",
    "typescript": "5.9.3",
    "vite": "6.4.5"
  }
}
